# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is ignored by git, so your real password never gets committed.

# Database settings, used by docker-compose.yml to create the database,
# and later by Python to connect to it.
POSTGRES_USER=lendsmart
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lendsmart
# The port on your Mac that leads to Postgres inside the container.
# 5432 and 5433 are already used on this Mac (Homebrew Postgres and pg-learn).
POSTGRES_PORT=5434
# Where Python finds the database. "localhost" means "this computer".
POSTGRES_HOST=localhost
